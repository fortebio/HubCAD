# Dev API port (Docker overrides this to 3001 in docker-compose.yml)
API_PORT=3002
DATABASE_URL=./data/drawing-tool.db
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=./uploads

# Email (optional). If SMTP_HOST is empty, notifications are logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Drawing Tool <no-reply@forte-biotech.local>"

# Default ECN recipient addresses (comma-separated) when recipient is "vendor", "oem", etc.
ECN_VENDOR_EMAILS=
ECN_OEM_EMAILS=
ECN_QUALITY_EMAILS=
ECN_SALES_EMAILS=

# CAD project root browsed by the CAD Source page. Empty disables that page.
CAD_ROOT=
# Optional: pin the Python interpreter (default: the project .venv, then PATH)
CAD_PYTHON=
