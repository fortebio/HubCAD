{
  "name": "drawing-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Technical Drawing Publishing Tool for Forte Biotech",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/copy-occt.js",
    "setup:occt": "node scripts/copy-occt.js",
    "server": "tsx watch server/index.js",
    "dev:all": "concurrently -n web,api -c blue,green \"npm:dev\" \"npm:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node server/db/seed.js",
    "db:reset": "node server/db/reset.js"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.1.5",
    "@tabler/icons-react": "^3.26.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.4.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "docx": "^9.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "occt-import-js": "^0.0.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "three": "^0.169.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "vite": "^5.4.11"
  }
}
